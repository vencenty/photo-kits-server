syntax = "v1"

type UploadResponse {
	// 文件名
	Filename string `json:"filename"`
	// 文件大小
	Size int64 `json:"size"`
	// 文件sha1
	Sha1 string `json:"sha1"`
	// 文件完整路径
	URL string `json:"url"`
}

type Photo {
	Spec string `json:"spec"`
	// 照片链接
	Metadata []PhotoMetadata `json:"metadata"`
}

type PhotoMetadata {
	// 图像地址
	URL string `json:"url"`
	// 是否已经调整过尺寸
	IsResized int64 `json:"is_resized"`
}

type SubmitRequest {
	// 订单号
	OrderSn string `json:"order_sn"`
	// 收件人
	Receiver string `json:"receiver"`
	// 备注信息
	Remark string `json:"remark"`
	// 照片列表
	Photos []Photo `json:"photos"`
}

// 上传响应值
type SubmitResponse {
	// 总上传数量
	Total int64 `json:"total"`
}

type OrderInfoRequest {
	OrderSn string `json:"order_sn"`
}

type OrderInfoResponse {
	// 订单号
	OrderSn string `json:"order_sn"`
	// 收件人信息
	Receiver string `json:"receiver"`
	// 备注信息
	Remark string `json:"remark"`
	// 订单状态
	Status int64 `json:"status"`
	//  订单创建时间
	CreatedAt string `json:"created_at"`
	// 照片列表
	Photos []Photo `json:"photos"`
}

type OrderItem {
	ID int64 `json:"id"`
	// 订单号
	OrderSn string `json:"order_sn"`
	// 收件人信息
	Receiver string `json:"receiver"`
	// 订单状态
	Status int64 `json:"status"`
	//  订单创建时间
	CreatedAt string `json:"created_at"`
}

type OrderListRequest {
	// 订单号
	OrderSn string `form:"order_sn,optional"`
	// 收件人信息
	Receiver string `form:"receiver,optional"`
	// 备注信息
	Remark string `form:"remark,optional"`
	// 订单状态 (-1表示不筛选, 0待处理, 1处理中, 2已完成)
	Status int64 `form:"status,optional"`
	// 订单创建时间
	CreatedAt string `form:"created_at,optional"`
	// 当前页码
	Page int64 `form:"page,optional"`
	// 页面大小
	PageSize int64 `form:"page_size,optional"`
}

type OrderListResponse {
	// 订单列表
	List []OrderItem `json:"list"`
	// 总数
	Total int64 `json:"total"`
	// 当前页码
	Page int64 `json:"page"`
	// 页面大小
	PageSize int64 `json:"page_size"`
	// 总页数
	Pages int64 `json:"pages"`
}

type OrderDeleteRequest {
	OrderIds []int64 `json:"order_id"`
}

type OrderDeleteResponse {
	Total int64 `json:"total"` // 删除了多少个
}

type OrderUpdateStatusRequest {
	OrderId int64 `json:"order_id"`
	Status  int64 `json:"status"`
}

type OrderUpdateStatusResponse {}

@server (
	group: photo
)
service photo-api {
	// 上传照片接口
	@handler Upload
	post /api/photo/upload returns (UploadResponse)

	// 提交订单
	@handler Submit
	post /api/order/submit (SubmitRequest) returns (SubmitResponse)

	// 订单数据
	@handler OrderInfo
	post /api/order/info (OrderInfoRequest) returns (OrderInfoResponse)

	@handler OrderList
	get /api/order/list (OrderListRequest) returns (OrderListResponse)

	@handler DeleteOrder
	post /api/order/delete (OrderDeleteRequest) returns (OrderDeleteResponse)

	@handler UpdateOrderStatus
	post /api/order/update_status (OrderUpdateStatusRequest) returns (OrderUpdateStatusResponse)

	@handler Ping
	get /api/ping returns (string)
}

