syntax = "v1"

type UploadResponse {
	// 文件名
	Filename string `json:"filename"`
	// 文件大小
	Size int64 `json:"size"`
	// 文件sha1
	Sha1 string `json:"sha1"`
	// 文件完整路径
	URL string `json:"url"`
}

type Photo {
	Spec string `json:"spec"`
	// 照片链接
	Metadata []PhotoMetadata `json:"metadata"`
}

type PhotoMetadata {
	// 图像地址
	URL string `json:"url"`
	// 是否已经调整过尺寸
	IsResized int64 `json:"is_resized"`
	// 照片数量
	Num int64 `json:"num"`
}

type SubmitRequest {
	// 订单号
	OrderSn string `json:"order_sn"`
	// 收件人
	Receiver string `json:"receiver"`
	// 备注信息
	Remark string `json:"remark"`
	// 保存类型
	SaveType string `json:"save_type"`
	// 照片数量
	PhotoCount int64 `json:"photo_count,optional"`
	// 照片列表
	Photos []Photo `json:"photos"`
}

// 上传响应值
type SubmitResponse {
	// 总上传数量
	Total int64 `json:"total"`
}

type OrderInfoRequest {
	OrderSn string `json:"order_sn"`
}

type OrderInfoResponse {
	// 订单号
	OrderSn string `json:"order_sn"`
	// 收件人信息
	Receiver string `json:"receiver"`
	// 备注信息
	Remark string `json:"remark"`
	// 订单状态
	Status int64 `json:"status"`
	//  订单创建时间
	CreatedAt string `json:"created_at"`
	// 照片列表
	Photos []Photo `json:"photos"`
}

type OrderItem {
	ID int64 `json:"id"`
	// 订单号
	OrderSn string `json:"order_sn"`
	// 收件人信息
	Receiver string `json:"receiver"`
	// 订单状态
	Status int64 `json:"status"`
	//  订单创建时间
	CreatedAt string `json:"created_at"`
}

type OrderListRequest {
	// 订单号
	OrderSn string `form:"order_sn,optional"`
	// 收件人信息
	Receiver string `form:"receiver,optional"`
	// 备注信息
	Remark string `form:"remark,optional"`
	// 订单状态 (-1表示不筛选, 0待处理, 1处理中, 2已完成)
	Status int64 `form:"status,optional"`
	// 订单创建时间
	CreatedAt string `form:"created_at,optional"`
	// 当前页码
	Page int64 `form:"page,optional"`
	// 页面大小
	PageSize int64 `form:"page_size,optional"`
}

type OrderListResponse {
	// 订单列表
	List []OrderItem `json:"list"`
	// 总数
	Total int64 `json:"total"`
	// 当前页码
	Page int64 `json:"page"`
	// 页面大小
	PageSize int64 `json:"page_size"`
	// 总页数
	Pages int64 `json:"pages"`
}

type OrderDeleteRequest {
	OrderIds []int64 `json:"order_id"`
}

type OrderDeleteResponse {
	Total int64 `json:"total"` // 删除了多少个
}

type OrderUpdateStatusRequest {
	OrderId []int64 `json:"order_id"`
	Status  int64   `json:"status"`
}

type OrderUpdateStatusResponse {
	Total int64 `json:"total"` // 更新了多少个
}

// 管理员登录请求
type AdminLoginRequest {
	// 邮箱或手机号
	Account string `json:"account"`
	// 密码
	Password string `json:"password"`
}

type AdminLoginResponse {
	Token string `json:"token"`
}

// 管理员登录响应
type AdminInfoResponse {
	// 管理员ID
	Id int64 `json:"id"`
	// 昵称
	Nickname string `json:"nickname,optional"`
	// 头像URL
	AvatarUrl string `json:"avatar_url,optional"`
	// 邮箱
	Email string `json:"email,optional"`
	// 手机号
	Mobile string `json:"mobile,optional"`
	// 创建时间
	CreatedAt string `json:"created_at,optional"`
	// 更新时间
	UpdatedAt string `json:"updated_at,optional"`
}

type AdminInfoRequest {}

// 管理员接口
@server (
	group: admin
)
service photo-api {
	// 管理员登陆接口
	@handler AdminLogin
	post /api/admin/login (AdminLoginRequest) returns (AdminLoginResponse)
}

@server (
	group: admin
	jwt:   Auth // 开启 jwt 认证
)
service photo-api {
	// 管理员登录
	//@handler AdminLogin
	//post /api/admin/login (AdminInfoRequest) returns (AdminInfoResponse)
	@handler AdminInfo
	post /api/admin/info (AdminInfoRequest) returns (AdminInfoResponse)

	// 管理员订单列表
	@handler AdminOrderList
	get /api/admin/order/list (OrderListRequest) returns (OrderListResponse)

	// 删除订单
	@handler AdminOrderDelete
	post /api/admin/order/delete (OrderDeleteRequest) returns (OrderDeleteResponse)

	// 更新订单状态
	@handler AdminOrderUpdateStatus
	post /api/admin/order/update_status (OrderUpdateStatusRequest) returns (OrderUpdateStatusResponse)

	// 订单详情
	@handler AdminOrderInfo
	post /api/admin/order/info (OrderInfoRequest) returns (OrderInfoResponse)
}

// 客户端接口
@server (
	group: api
)
service photo-api {
	// 上传照片接口
	@handler Upload
	post /api/photo/upload returns (UploadResponse)

	// 上传到oss
	@handler UploadOss
	post /api/upload/oss returns (UploadResponse)

	// 提交订单
	@handler Submit
	post /api/order/submit (SubmitRequest) returns (SubmitResponse)

	// 订单数据
	@handler OrderInfo
	post /api/order/info (OrderInfoRequest) returns (OrderInfoResponse)

	@handler Ping
	get /api/ping returns (string)
}

