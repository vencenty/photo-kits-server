Name: photoSync-job
Host: 0.0.0.0
Port: 8080
Timeout: 3600
MaxBytes: 1073741824

Log:
  ServiceName: photoSync-job
  Mode: file
  Path: logs
  Level: info
  Compress: true
  KeepDays: 7
  StackCooldownMillis: 100

Database:
  DataSource: root:123456@tcp(localhost:3306)/photo_kits?charset=utf8mb4&parseTime=true&loc=Asia%2FShanghai

Minio:
  Schema: http
  Endpoint: localhost:9000
  AccessKey: minioadmin
  SecretKey: minioadmin
  UseSSL: false
  Bucket: photo-kits

# 同步任务配置
SyncConfig:
  BatchSize: 50                    # 每批处理的订单数量
  Timeout: 3600                    # 整体同步超时时间（秒）
  SourcePath: /path/to/source      # 源文件路径（保留字段）
  BackupPath: /path/to/backup      # 备份路径（保留字段）
  OutputPath: /path/to/output      # 照片输出根目录
  
  # 下载重试配置
  DownloadTimeout: 30              # 初始下载超时时间（秒）
  MaxRetries: 3                    # 最大重试次数
  RetryBaseDelay: 2                # 重试基础延迟时间（秒）
  MaxDownloadTimeout: 120          # 最大下载超时时间（秒）
  
  # 异步重试配置
  AsyncRetry: true                 # 是否启用异步重试（推荐开启）
  RetryWorkers: 5                  # 重试协程池大小
  RetryChannelSize: 1000           # 重试队列大小 